{
    "configurations": [
        {
            "name": "Cpp",
            "includePath": [
                "${workspaceFolder}/**"
            ],
            "defines": [],
            "cStandard": "c17",
            "cppStandard": "c++17",
            "configurationProvider": "ms-vscode.cmake-tools",
            "intelliSenseMode": "linux-gcc-x64",
            "compilerPath": "/usr/bin/g++",
            "compilerArgs": [
                "-std=c++20",
                "-Wpedantic",
                "-Wall",
                "-Wextra",
                "-Werror",
                "-Wunused",
                "-Wconversion",
                "-Wsign-conversion",
                "-O2",
                "-g",
                "-fsanitize=address", // or -fsanitize=thread
                "-fsanitize=undefined",
                "-fanalyzer",
                "-fdiagnostics-show-option"
            ],
            "browse": {
                "path": ["${workspaceFolder}/**", "/usr/include", "/usr/local/include"],
                "limitSymbolsToIncludedHeaders": false
              }
        }
    ],
    "version": 4,
    "enableConfigurationSquiggles": true
}
