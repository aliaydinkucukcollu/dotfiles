{
    // Editor config
    "editor.fontFamily": "Cascadia Code, 'Fira Code', Consolas, monospace",
    // "editor.fontFamily": "'JetBrains Mono', 'Fira Code', Consolas, monospace",
    "editor.fontLigatures": true,
    "editor.accessibilitySupport": "off",
    "editor.fontSize": 18,
    "editor.tabSize": 4,
    "editor.formatOnSave": true,
    "editor.codeActionsOnSave": {
        "source.fixAll": "explicit",
        "source.convertImportFormat": "explicit",
        "source.unusedImports": "explicit"
    },
    "editor.tokenColorCustomizations": {
        "comments": "#747474"
    },
    // Controls if quick suggestions should show up while typing
    "editor.quickSuggestions": {
        "other": true,
        "comments": false,
        "strings": false
    },
    "editor.acceptSuggestionOnCommitCharacter": true,
    "editor.acceptSuggestionOnEnter": "on",
    "editor.quickSuggestionsDelay": 1,
    "editor.suggestOnTriggerCharacters": true,
    "editor.tabCompletion": "on",
    "editor.suggest.localityBonus": true,
    "editor.suggestSelection": "first",
    "editor.wordBasedSuggestions": "matchingDocuments",
    "editor.parameterHints.enabled": true,
    "workbench.tree.indent": 10,
    "workbench.iconTheme": "vscode-icons",
    "workbench.colorTheme": "Gruvbox Dark Hard",
    "workbench.colorCustomizations": {
        "tree.indentGuidesStroke": "#00c3ff"
    },
    // Terminal font
    "terminal.integrated.fontSize": 18,
    // Zoom
    "window.zoomLevel": 0,
    "files.autoSave": "afterDelay",
    "explorer.compactFolders": false,
    "[python]": {
        "editor.formatOnType": true
    },
    "git.openRepositoryInParentFolders": "never",
    "[cpp]": {
        "editor.defaultFormatter": "llvm-vs-code-extensions.vscode-clangd"
    },
    "clangd.arguments": [
        "--fallback-style=Google",
        "--compile-commands-dir=/home/robot/bmc_auto_driver/tulga_ws/build"
    ],
    "python.autoComplete.extraPaths": [
        "/opt/ros/humble/lib/python3.10/site-packages",
        "${workspaceFolder}/install/local/lib/python3.10/site-packages"
    ],
    // ---------------> C++ <---------------
    // "C_Cpp.errorSquiggles": "enabled",
    "C_Cpp.intelliSenseEngine": "disabled",
    "C_Cpp.default.compilerPath": "/usr/bin/g++",
    "C_Cpp.default.cppStandard": "c++17",
    "C_Cpp.workspaceParsingPriority": "high",
    "C_Cpp.default.compileCommands": "/home/robot/bmc_auto_driver/tulga_ws/build/compile_commands.json",
    // -------------------------------------
    "ROS2.distro": "humble",
    "python.analysis.extraPaths": [
        "/home/robot/bmc_auto_driver/tulga_ws/install/umrr_ros2_msgs/local/lib/python3.10/dist-packages",
        "/home/robot/bmc_auto_driver/tulga_ws/install/sbg_driver/local/lib/python3.10/dist-packages",
        "/home/robot/bmc_auto_driver/tulga_ws/install/rslidar_msg/local/lib/python3.10/dist-packages",
        "/home/robot/bmc_auto_driver/tulga_ws/install/ros2_web_dashboard/lib/python3.10/site-packages",
        "/home/robot/bmc_auto_driver/tulga_ws/install/robot_localization/local/lib/python3.10/dist-packages",
        "/home/robot/bmc_auto_driver/tulga_ws/install/lslidar_msgs/local/lib/python3.10/dist-packages",
        "/home/robot/bmc_auto_driver/tulga_ws/install/fast_lio/local/lib/python3.10/dist-packages",
        "/home/robot/bmc_auto_driver/tulga_ws/install/livox_ros_driver2/local/lib/python3.10/dist-packages",
        "/home/robot/bmc_auto_driver/tulga_ws/install/lio_sam/local/lib/python3.10/dist-packages",
        "/home/robot/bmc_auto_driver/tulga_ws/install/direct_lidar_inertial_odometry/local/lib/python3.10/dist-packages",
        "/opt/ros/humble/lib/python3.10/site-packages",
        "",
        "/opt/ros/humble/local/lib/python3.10/dist-packages",
        "${workspaceFolder}/install/local/lib/python3.10/site-packages"
    ],
    "files.exclude": {
        "**/build/**": true,
        "**/install/**": false,
        "**/log/**": true
    },
    "ros.distro": "humble"
}